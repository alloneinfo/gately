#!/bin/sh /etc/rc.common
# Gately 的 OpenWrt procd 启动脚本。安装：
#   cp gately /usr/bin/gately && chmod +x /usr/bin/gately
#   cp gately.init /etc/init.d/gately && chmod +x /etc/init.d/gately
#   /etc/init.d/gately enable && /etc/init.d/gately start
#   logread | grep -i "initial password"

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/gately
CONF_DIR=/etc/gately

start_service() {
	mkdir -p "$CONF_DIR"
	chmod 700 "$CONF_DIR"
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF_DIR"
	# 进程异常退出后自动拉起：阈值 3600 秒内最多 5 次，间隔 5 秒
	procd_set_param respawn 3600 5 5
	procd_set_param limits nofile="65535 65535"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
